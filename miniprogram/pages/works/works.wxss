.heading { margin: 8px 2px 20px; }
.page-title { font-size: 24px; font-weight: 600; }
.search-card { padding: 12px; }
.empty-button { margin: 20px auto 0; max-width: 180px; }
.work-content { display: flex; gap: 14px; }
.cover { width: 78px; height: 106px; flex-shrink: 0; background: #f3f4f6; border-radius: 6px; }
.work-info { min-width: 0; flex: 1; }
.work-title { display: block; font-size: 16px; font-weight: 600; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.work-summary { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: #767b84; font-size: 13px; line-height: 1.6; margin-top: 5px; }
.work-info .caption { font-size: 12px; margin-top: 5px; }
.work-card .actions button { min-width: 0; }
.detail-text { display: block; white-space: pre-wrap; font-size: 15px; margin-top: 14px; line-height: 1.8; max-height: 180px; overflow-y: auto; }
.footer-note { display: block; color: #858a93; font-size: 12px; text-align: center; line-height: 1.6; margin: 20px 12px 0; }
