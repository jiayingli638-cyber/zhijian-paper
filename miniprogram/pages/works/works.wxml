<view class="page">
    <view class="heading row"><text class="page-title">纸上的收藏</text><text class="muted">{{total}} 份本地作品</text></view>
    <view class="card detail" wx:if="{{selected}}">
        <view class="row"><text class="section-title">作品预览</text><button class="small secondary" bindtap="closeViewer" disabled="{{busy}}">关闭</button></view>
        <swiper wx:if="{{viewerPages.length}}" class="viewer" current="{{viewerIndex}}" bindchange="changePage"><swiper-item wx:for="{{viewerPages}}" wx:key="*this"><image src="{{item}}" mode="aspectFit" data-index="{{index}}" bindtap="previewImage" /></swiper-item></swiper>
        <text class="page-count" wx:if="{{viewerPages.length}}">{{viewerIndex + 1}} / {{viewerPages.length}} · 点击图片放大</text>
        <text class="error-text" wx:if="{{fileError}}">{{fileError}}</text>
        <text class="caption">字号 {{selected.params.font_size}} · 行距 {{selected.params.line_spacing}} · 种子 {{selected.params.seed}}</text>
        <text class="detail-text" selectable="{{true}}">{{selected.text}}</text>
        <view class="actions"><button class="primary" bindtap="saveAll" disabled="{{busy || !viewerPages.length}}" loading="{{busy}}">保存全部到相册</button><button class="secondary" bindtap="copyText" disabled="{{busy}}">复制文字</button></view>
        <view class="actions"><button class="secondary" data-id="{{selected.id}}" bindtap="editWork" disabled="{{busy}}">恢复编辑</button><button class="secondary" data-id="{{selected.id}}" bindtap="deleteWork" disabled="{{busy}}">删除本地作品</button></view>
        <text class="caption" wx:if="{{albumProgress}}">{{albumProgress}}</text>
    </view>

    <view class="card search-card">
        <input class="field" value="{{query}}" placeholder="搜索正文或识别原文" confirm-type="search" bindinput="search" />
        <view class="chips"><button class="chip {{filter === item.id ? 'selected' : ''}}" wx:for="{{filters}}" wx:key="id" data-id="{{item.id}}" bindtap="selectFilter">{{item.name}}</button></view>
    </view>
    <view class="error-box" wx:if="{{error}}"><text class="error-title">操作未完成</text><text class="error-text">{{error}}</text><button class="secondary small" bindtap="refresh" disabled="{{busy}}">刷新重试</button></view>
    <view class="error-box" wx:if="{{cleanupError}}"><text class="error-title">文件清理未完成</text><text class="error-text">{{cleanupError}}</text><button class="secondary small" bindtap="refresh" disabled="{{busy}}">重试清理</button></view>

    <view class="card empty" wx:if="{{!works.length && !error}}">
        <view class="empty-mark"></view>
        <text class="section-title">{{total ? '没有找到这份作品' : '还没有纸上作品'}}</text>
        <text class="caption">{{total ? '换个关键词，或查看全部作品' : '从一张图片开始，留下第一份手写文字'}}</text>
        <button class="secondary empty-button" wx:if="{{total}}" bindtap="clearSearch">查看全部</button>
        <button class="primary empty-button" wx:else bindtap="startCreate">去创作</button>
    </view>
    <view class="card work-card" wx:for="{{works}}" wx:key="id">
        <view class="work-content"><image class="cover" src="{{item.cover}}" mode="aspectFit" data-id="{{item.id}}" bindtap="viewWork" /><view class="work-info"><text class="work-title">{{item.title}}</text><text class="work-summary">{{item.summary}}</text><text class="caption">{{item.description}}</text><text class="caption">{{item.meta}}</text></view></view>
        <view class="actions"><button class="secondary small" data-id="{{item.id}}" bindtap="viewWork" disabled="{{busy}}">查看</button><button class="secondary small" data-id="{{item.id}}" bindtap="editWork" disabled="{{busy}}">恢复编辑</button><button class="secondary small" data-id="{{item.id}}" bindtap="deleteWork" disabled="{{busy}}">删除</button></view>
    </view>
    <text class="footer-note">作品仅在本机保存。清理小程序数据或卸载可能导致丢失，重要作品请另存相册。</text>
</view>
